# Prototype 06 keeps its structured outputs and contact sheets in git; the
# bulk raster/geometry products are regenerated by `python synth_render.py`.
results/**/*.png
results/**/*.jpg
results/**/*.npz
results/**/*.glb
# ...except the contact sheets, which ARE the visual evidence for the run.
!results/**/*_contact.png
# Decimation caches (rebuilt from the rigged GLB by real_body.py).
assets/real_body_*mm.npz
__pycache__/
.pytest_cache/
# The full real detections are ~32 MB, almost all of it body polygons; the
# tracked variant is results/real/detections_slim.jsonl, written by the same
# run of real_features.py (see slim_record()).
results/real/detections.jsonl
# The calibration corpora are working products of calibrate.py (~30 MB each
# after gt-pruning, 57 of them); grid.jsonl, best.json, best_record.json,
# report.md and calibration_contact.png are the tracked outputs.
results/calibration/corpora/
results/calibration/compare/
results/calibration/real_side.pkl
results/calibration/probe.jsonl
# The calibrated corpus is 160 rendered frames plus their ground truth (~2 GB);
# truth.jsonl, config.json, summary.json, detector_summary.json and the contact
# sheets are the tracked evidence.  detections.jsonl is regenerated in ~60 s by
# `python synth_features.py --corpus results/synth_calib`.
results/synth_calib/detections.jsonl
results/constellation/synth_calib_gt_detections.jsonl
# Per-frame render ground truth (regenerated by synth_render.py from config.json + seed).
results/**/gt/*_spots.json
