                 recorded_by=row.get("annotator"),
                 identified_by=row.get("annotator"),
                 date_identified=row.get("annotation_date"),
@@ -402,8 +441,7 @@ class SharkScarAdapter(BaseAdapter):
                 year=row.get("year"),
                 organism_id=org.get("organism_id"),
                 organism_name=org.get("display_name") or row.get("nickname"),
-                scientific_name=org.get("scientific_name"),
-                scientific_name_id=org.get("scientific_name_id"),
+                **_taxon(org),
                 sex=normalize_sex(row.get("sex")),
                 catalog_number=code,
                 sampling_protocol="re-identification catalogue",
