# LabRAG settings. Copy to ~/.labrag/labrag.env (or run `labrag init`, which writes it).
# Blank values are ignored. Real environment variables override this file.

# --- Where the papers are -------------------------------------------------------------
# Folders to index, separated by ';'. NAS share, Google Drive for Desktop folder, any folder.
# Optional 'name=path' gives a source a short name shown in citations.
LABRAG_FOLDERS="/Volumes/LabNAS/Papers"

# Google Drive folder to read directly (link or ID), for machines without Drive for Desktop.
# Needs ONE of the two credential files below. See docs/GOOGLE-DRIVE.md.
LABRAG_DRIVE_FOLDER=
LABRAG_GOOGLE_SERVICE_ACCOUNT=      # path to a service-account JSON key (share the folder with its e-mail)
LABRAG_GOOGLE_CLIENT_SECRET=        # or: path to an OAuth "Desktop app" client secret JSON

# --- Where the index lives -------------------------------------------------------------
# One SQLite file plus caches. Put it on the NAS next to the papers so the lab shares one index.
LABRAG_DATA="/Volumes/LabNAS/Papers/labrag-index"

# --- Who writes the answers ------------------------------------------------------------
# With an Anthropic key, Claude writes the answers. Otherwise Ollama if running, else search-only.
ANTHROPIC_API_KEY=
# LABRAG_LLM=auto                  # anthropic | openai | ollama | none | auto
# LABRAG_LLM_MODEL=claude-opus-5   # claude-sonnet-5 is cheaper; llama3.1 for Ollama
# LABRAG_LLM_EFFORT=medium         # Claude reasoning effort: low | medium | high
# LABRAG_MAX_TOKENS=8000
# OPENAI_API_KEY=
# LABRAG_OPENAI_BASE_URL=https://api.openai.com/v1
# LABRAG_OLLAMA_URL=http://localhost:11434

# --- Embeddings (how passages are matched to questions) --------------------------------
# LABRAG_EMBED=fastembed           # fastembed (local, default) | ollama | openai | hash
# LABRAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Changing the embedder later requires `labrag index --rebuild`.

# --- Web page ----------------------------------------------------------------------------
# LABRAG_HOST=0.0.0.0              # reachable from the lab network
# LABRAG_PORT=8008
LABRAG_PASSWORD=                   # optional; any user name, this password

# --- Fine tuning ------------------------------------------------------------------------
# LABRAG_TOP_K=8                   # passages given to the model per question
# LABRAG_LOOKUP=on                 # look up title/authors/year on Crossref from each paper's DOI
